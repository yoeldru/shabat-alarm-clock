<?xml version="1.0" encoding="utf-8"?>
<!-- Written: 2026-10-29 22:00 (Asia/Jerusalem) -->
<resources>
    <style name="Theme.ShabatAlarm" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorTertiary">@color/gold</item>
    </style>

    <style name="Theme.ShabatAlarm.Ring" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/ring_accent</item>
        <item name="android:windowBackground">@color/ring_bg</item>
        <item name="android:statusBarColor">@color/ring_bg</item>
        <item name="android:navigationBarColor">@color/ring_bg</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
</resources>
